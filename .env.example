# --- Deployment ---
DOMAIN=receptionist.example-restaurant.in
COMPOSE_PROJECT_NAME=spice-route
APP_VERSION=1.0.0

# --- Core ---
ENVIRONMENT=production
SECRET_KEY=
PUBLIC_BASE_URL=https://receptionist.example-restaurant.in
DASHBOARD_URL=https://receptionist.example-restaurant.in
DASHBOARD_DIR=
CORS_ORIGINS=
LOG_LEVEL=INFO
SENTRY_DSN=

# --- Database ---
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+psycopg://resto:password@localhost:5432/resto

# --- Anthropic ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
LLM_TIMEOUT_SECONDS=20
VOICE_LLM_TIMEOUT_SECONDS=9

# --- Voice ---
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- WhatsApp Business Platform ---
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v23.0

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Usage cost estimates (paise) ---
COST_VOICE_PER_MINUTE_PAISE=100
COST_WHATSAPP_SERVICE_MSG_PAISE=0
COST_WHATSAPP_TEMPLATE_MSG_PAISE=90
COST_LLM_PER_1K_INPUT_TOKENS_PAISE=35
COST_LLM_PER_1K_OUTPUT_TOKENS_PAISE=170

SESSION_DAYS=14
