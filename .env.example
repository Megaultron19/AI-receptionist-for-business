# ─────────────────────────────────────────────────────────────────────────────
# AI Restaurant Receptionist — one file per restaurant installation.
# Copy to .env, fill in, and keep it out of git. Never share it between restaurants.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---
ENVIRONMENT=production
# 32+ random characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Public HTTPS URL of THIS installation (webhooks, QR links). No trailing slash.
PUBLIC_BASE_URL=https://receptionist.example-restaurant.in
DASHBOARD_URL=https://receptionist.example-restaurant.in
# Leave empty: the dashboard and API are served from the same origin by Caddy.
CORS_ORIGINS=
LOG_LEVEL=INFO
# Optional error tracking (Sentry or any Sentry-compatible service)
SENTRY_DSN=

# --- Database (docker-compose builds this from POSTGRES_PASSWORD) ---
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://resto:${POSTGRES_PASSWORD}@db:5432/resto

# --- AI (Claude) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low keeps phone replies fast; raise to medium if answers need more care
ANTHROPIC_EFFORT=low
LLM_TIMEOUT_SECONDS=20
VOICE_LLM_TIMEOUT_SECONDS=9

# --- Voice: configure the provider whose number you bought (Plivo for Indian numbers, Twilio international) ---
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- WhatsApp Business Platform (Cloud API) ---
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v23.0

# --- Razorpay (start with rzp_test_ keys) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Usage page cost estimates, in paise (set to your actual rates) ---
COST_VOICE_PER_MINUTE_PAISE=100
COST_WHATSAPP_SERVICE_MSG_PAISE=0
COST_WHATSAPP_TEMPLATE_MSG_PAISE=90
COST_LLM_PER_1K_INPUT_TOKENS_PAISE=35
COST_LLM_PER_1K_OUTPUT_TOKENS_PAISE=170

SESSION_DAYS=14
